{
  "name": "erp-chantier",
  "version": "0.1.0",
  "description": "ERP Gestion Terrain - Devis, Factures, Bons de Commande, RH",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "npm run type-check && npm run type-check:ecran && npm run test:run && npm run build",
    "type-check": "tsc --noEmit",
    "type-check:ecran": "tsc -p tsconfig.ecran.json",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "db:types": "supabase gen types typescript --linked > src/api/database.types.ts && npm run db:columns",
    "db:pull": "supabase db pull",
    "db:columns": "node scripts/gen-columns.mjs",
    "globaux:ecran": "node scripts/gen-globaux-ecran.mjs",
    "apercu": "node scripts/apercu.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.43.4",
    "docx": "8.5.0",
    "html2pdf.js": "0.14.0",
    "pdf-lib": "^1.17.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@xmldom/xmldom": "^0.9.12",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.3.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
