# Copier en `.env.local` (jamais versionné) et renseigner.
#
# Toute variable préfixée VITE_ est inlinée EN CLAIR dans le bundle navigateur :
# n'y mettre que des valeurs publiques. La clé anon l'est ; la RLS protège.
# Un secret (service_role, clé OCR…) ne porte JAMAIS ce préfixe.

# URL de l'API Supabase. En local : celle qu'affiche `npx supabase start`
# dans web/ (http://127.0.0.1:55421). Ne JAMAIS pointer la production depuis
# un poste de développement.
VITE_SUPABASE_URL=http://127.0.0.1:55421

# Clé publique (anon / publishable) du même projet.
VITE_SUPABASE_ANON_KEY=

