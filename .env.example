# ============================================================
# ⚠ Règle de sûreté
#
# Tout ce qui est préfixé VITE_ est inliné EN CLAIR dans le bundle
# navigateur dès que le code y fait référence. Vérifiable :
#   npm run build && grep -o "eyJ[A-Za-z0-9_.-]*" dist/assets/client-*.js
#
# → Ne JAMAIS préfixer VITE_ un secret (jeton d'accès, service_role,
#   mot de passe). Les variables sans préfixe restent côté Node.
# ============================================================

# --- Public : destiné au navigateur, borné par la RLS ---
VITE_SUPABASE_URL=https://tjhljjuvfosmnpmzgbnl.supabase.co
VITE_SUPABASE_ANON_KEY=votre_cle_anon

# --- Tests d'intégration (facultatif, jamais bundlé) ---
# Utilisateur applicatif ordinaire : les tables étant sous RLS, sans lui
# les suites d'intégration se désactivent au lieu de partir en échec.
# TEST_USER_EMAIL=
# TEST_USER_PASSWORD=
# TEST_SOCIETE_CODE=kta

# --- Ne mettez PAS ceci ici ---
# SUPABASE_ACCESS_TOKEN et SERVICE_ROLE_KEY donnent un accès admin qui
# ignore la RLS. Ils se configurent dans le serveur MCP (~/.claude.json),
# hors du dépôt, pas dans un fichier du projet.
